# Copia este archivo a .env.local y rellena tus valores.

# Clave de la API de Claude (Anthropic). Obtenla en https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Modelo de Claude a utilizar para el análisis de licitaciones.
# Por defecto usamos Claude Sonnet 5 (buen equilibrio calidad/coste/velocidad).
ANTHROPIC_MODEL=claude-sonnet-5
